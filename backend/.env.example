# Copy to backend/.env (gitignored) and fill in. Read by haven/config.py.
# Tiger Cloud: use the "Service URL" from your service's credentials.
# When set, profiles, user-added properties and reports are saved in this database.
# When empty, they are kept in memory and lost on restart.
ORS_API_KEY=""
HAVEN_DATABASE_URL=""

# Photo screening (damp / mould / entrance step) with Google Gemini.
#   1. Create a key at https://aistudio.google.com/apikey (Google AI Studio, not Vertex AI).
#   2. Set HAVEN_VISION_PROVIDER="gemini" and paste the key into HAVEN_GEMINI_API_KEY.
#   3. Check it: `uv run poe check-gemini` (add a photo path to screen a real photo).
#   4. Restart the API. Screening needs sign-in (Auth0) and is rate limited per user.
# Empty provider or key = no model ("can't tell" for every signal); the app still runs.
HAVEN_VISION_PROVIDER=""
HAVEN_GEMINI_API_KEY=""
# Optional overrides. check-gemini lists the models your key can use.
# HAVEN_GEMINI_MODEL="gemini-3.8-flash"
# HAVEN_GEMINI_TIMEOUT_SECONDS=30
# HAVEN_PHOTO_SCREEN_RATE_LIMIT=10

# Report wording: "template" (default) or "gemini" (Gemini rewords the template sentences).
# HAVEN_REPORT_WORDING="gemini"
