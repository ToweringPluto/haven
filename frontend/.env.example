# Copy to .env.local and fill in from your Auth0 tenant (see docs/AUTH0_SETUP.md).
# Leave these empty to run the public demo only: signed-in features then show labelled samples.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Backend origin. Leave empty in development to use the Vite proxy for /v1.
VITE_API_BASE_URL=
